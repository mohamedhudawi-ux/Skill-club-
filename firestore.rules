rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function getUserData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return isSignedIn() && getUserData().role == 'admin'; }
    function isStaff() { return isSignedIn() && (getUserData().role == 'staff' || getUserData().role == 'treasurer' || isAdmin()); }
    function isSafa() { return isSignedIn() && (getUserData().role == 'safa' || isAdmin()); }
    function isAcademic() { return isSignedIn() && (getUserData().role == 'academic' || isAdmin()); }
    function isStudent() { return isSignedIn() && getUserData().role == 'student'; }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /users/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }
    
    match /campuses/{campusId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /students/{admissionNumber} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }
    
    match /cceMarks/{markId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff() || isAcademic();
    }
    
    match /skillClubEntries/{entryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff() || isSafa();
    }
    
    match /programs/{programId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff() || isSafa();
    }
    
    match /gallery/{itemId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /clubs/{clubId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /clubMembers/{memberId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /boards/{boardId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /boardMembers/{memberId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /workSubmissions/{submissionId} {
      allow read: if isSignedIn() && (resource.data.studentUid == request.auth.uid || isAdmin() || isStaff() || isSafa());
      allow create: if isSignedIn() && request.resource.data.studentUid == request.auth.uid;
      allow update: if isSignedIn() && (isAdmin() || isStaff() || isSafa() || resource.data.studentUid == request.auth.uid);
      allow delete: if isAdmin();
    }
    
    match /officeBearers/{bearerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /siteContent/{contentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /queries/{queryId} {
      allow read: if isSignedIn() && (resource.data.studentUid == request.auth.uid || isAdmin() || isStaff());
      allow create: if isSignedIn() && request.resource.data.studentUid == request.auth.uid;
      allow update: if isSignedIn() && (isAdmin() || isStaff() || resource.data.studentUid == request.auth.uid);
      allow delete: if isAdmin();
    }
    
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.recipientUid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
    
    match /clubPointEntries/{entryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }
    
    match /monthlyReports/{reportId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }
    
    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
